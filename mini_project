import os
import sys
import pymysql
import pymysql.cursors
from PyQt6.QtCore import Qt
from PyQt6.QtGui import QPixmap
from PyQt6.QtWidgets import *

DB = dict(host="localhost", user="root", password="12345", database="shoes_store2", charset="utf8mb4", cursorclass=pymysql.cursors.DictCursor)

def run(sql, args=(), one=False):
    with pymysql.connect(**DB) as c:
        with c.cursor() as cur:
            cur.execute(sql, args)
            if sql.strip().upper().startswith("SELECT"):
                return cur.fetchone() if one else cur.fetchall()
        c.commit()

class Login(QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Вход"); self.setFixedSize(300, 190); self.w = None
        L = QVBoxLayout(self)
        L.addWidget(QLabel("<h2 align='center'>Магазин обуви</h2>"))
        self.lg = QLineEdit(placeholderText="Логин"); L.addWidget(self.lg)
        self.pw = QLineEdit(placeholderText="Пароль"); self.pw.setEchoMode(QLineEdit.EchoMode.Password); L.addWidget(self.pw)
        b1 = QPushButton("Войти"); b1.clicked.connect(self.login); L.addWidget(b1)
        b2 = QPushButton("Гость"); b2.clicked.connect(lambda: self.go({"full_name":"Гость","role":"guest"})); L.addWidget(b2)
        self.pw.returnPressed.connect(self.login)

    def login(self):
        u = run("SELECT u.*,r.name AS role FROM users u JOIN roles r ON u.role_id=r.id WHERE u.login=%s AND u.password=%s", (self.lg.text().strip(), self.pw.text().strip()), one=True)
        if not u: QMessageBox.critical(self, "Ошибка", "Неверный логин или пароль."); return
        self.go(u)

    def go(self, user):
        self.hide(); self.w = Main(user, self); self.w.show()

class Main(QMainWindow):
    def __init__(self, user, login):
        super().__init__()
        self.user = user; self.login = login; self.form = None; self.sid = None; self.all = []; self.rev = False
        self.setWindowTitle(f"Магазин обуви — {user['role']}"); self.resize(1000, 600)

        tb = self.addToolBar("t"); tb.setMovable(False)
        sp = QWidget(); sp.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred); tb.addWidget(sp)
        tb.addWidget(QLabel(f"  {user['full_name']}  "))
        bo = QPushButton("Выйти"); bo.clicked.connect(self.logout); tb.addWidget(bo)

        c = QWidget(); self.setCentralWidget(c); L = QVBoxLayout(c)

        row = QHBoxLayout()
        self.se = QLineEdit(placeholderText="Поиск..."); self.se.textChanged.connect(self.filt); row.addWidget(self.se)
        self.cb = QComboBox(); self.cb.currentTextChanged.connect(self.filt); row.addWidget(self.cb)
        for t,r in [("↑",False),("↓",True)]:
            b = QPushButton(f"Кол-во {t}"); b.clicked.connect(lambda _,x=r: self.sort(x)); row.addWidget(b)
        row.addStretch(); L.addLayout(row)

        if user["role"] in ("manager","admin"):
            row2 = QHBoxLayout()
            for t,fn in [("Добавить",lambda:self.edit(None)),("Редактировать",lambda:self.edit(self.sid)),("Удалить",self.delete),("Заказы",lambda:Orders(self).exec())]:
                b = QPushButton(t); b.clicked.connect(fn); row2.addWidget(b)
            row2.addStretch(); L.addLayout(row2)

        sc = QScrollArea(); sc.setWidgetResizable(True)
        self.box = QWidget(); self.bl = QVBoxLayout(self.box); self.bl.setSpacing(6); self.bl.addStretch()
        sc.setWidget(self.box); L.addWidget(sc)
        self.load()

    def load(self):
        self.all = run("SELECT p.*,c.name AS category,m.name AS manufacturer,s.name AS supplier FROM products p LEFT JOIN categories c ON p.category_id=c.id LEFT JOIN manufacturers m ON p.manufacturer_id=m.id LEFT JOIN suppliers s ON p.supplier_id=s.id ORDER BY p.id")
        sups = ["Все поставщики"]+sorted({r["supplier"] for r in self.all if r["supplier"]})
        self.cb.blockSignals(True); self.cb.clear(); self.cb.addItems(sups); self.cb.blockSignals(False)
        self.filt()

    def filt(self):
        s = self.se.text().lower(); sup = self.cb.currentText()
        res = [r for r in self.all if (not s or any(s in str(v).lower() for v in r.values())) and (sup=="Все поставщики" or r["supplier"]==sup)]
        res.sort(key=lambda r: r["quantity"] or 0, reverse=self.rev)
        while self.bl.count()>1: w=self.bl.takeAt(0).widget();w and w.deleteLater()
        for r in res:
            d=float(r["discount"] or 0); q=int(r["quantity"] or 0); p=float(r["price"] or 0)
            card=QFrame(); card.setFixedHeight(160); card.setFrameShape(QFrame.Shape.Box)
            card.setStyleSheet("background:#ADD8E6" if q==0 else ("background:#2E8B57" if d>15 else "background:white"))
            h=QHBoxLayout(card); h.setContentsMargins(8,8,8,8)
            ph=QLabel(); ph.setFixedSize(140,140); ph.setAlignment(Qt.AlignmentFlag.AlignCenter); ph.setStyleSheet("border:1px solid gray;background:white")
            img=r["image_path"] if r["image_path"] and os.path.exists(r["image_path"]) else "images/picture.png"
            px=QPixmap(img)
            if not px.isNull(): ph.setPixmap(px.scaled(140,140,Qt.AspectRatioMode.KeepAspectRatio))
            else: ph.setText("Фото")
            h.addWidget(ph)
            tc="white" if d>15 and q>0 else "black"
            info=QVBoxLayout(); info.setSpacing(2)
            for txt in [f"<b>{r['category']} | {r['name']}</b>",f"Описание: {r['description'] or '—'}",f"Производитель: {r['manufacturer'] or '—'}",f"Поставщик: {r['supplier'] or '—'}",f"Цена: <s style='color:red'>{p}</s> <b>{round(p*(1-d/100),2)}</b>" if d>0 else f"Цена: <b>{p}</b>",f"Ед. изм.: {r['unit'] or '—'}",f"На складе: {q}"]:
                l=QLabel(txt); l.setStyleSheet(f"color:{tc};border:none"); info.addWidget(l)
            h.addLayout(info,1)
            dl=QLabel(f"{int(d)}%" if d else "—"); dl.setFixedSize(120,140); dl.setAlignment(Qt.AlignmentFlag.AlignCenter); dl.setStyleSheet("border:1px solid gray;font-size:22px;font-weight:bold;background:white;color:black"); h.addWidget(dl)
            rid=r["id"]; card.mousePressEvent=lambda e,i=rid: setattr(self,"sid",i)
            self.bl.insertWidget(self.bl.count()-1,card)

    def sort(self, rev): self.rev=rev; self.filt()

    def edit(self, pid):
        if self.form: QMessageBox.warning(self,"!","Форма уже открыта."); self.form.activateWindow(); return
        if pid and not any(r["id"]==pid for r in self.all): QMessageBox.information(self,"i","Выберите товар."); return
        prod=next((r for r in self.all if r["id"]==pid),None) if pid else None
        self.form=Form(self,prod); self.form.show()

    def delete(self):
        if not self.sid: QMessageBox.information(self,"i","Выберите товар."); return
        if run("SELECT COUNT(*) AS c FROM order_items WHERE product_id=%s",(self.sid,),one=True)["c"]:
            QMessageBox.critical(self,"!","Товар есть в заказах."); return
        if QMessageBox.question(self,"?","Удалить товар?") == QMessageBox.StandardButton.Yes:
            run("DELETE FROM products WHERE id=%s",(self.sid,)); self.sid=None; self.load()

    def logout(self):
        self.close(); self.login.lg.clear(); self.login.pw.clear(); self.login.show()

class Form(QDialog):
    def __init__(self, parent, p=None):
        super().__init__(parent)
        self.p=p; self.img=p["image_path"] if p else None
        self.setWindowTitle("Товар"); self.setMinimumWidth(400)
        self.finished.connect(lambda: setattr(parent,"form",None))
        L=QVBoxLayout(self); F=QFormLayout()
        if p: id_f=QLineEdit(str(p["id"])); id_f.setReadOnly(True); F.addRow("ID:",id_f)
        self.n=QLineEdit(p["name"] if p else ""); F.addRow("Название*:",self.n)
        self.pr=QLineEdit(str(p["price"]) if p else ""); F.addRow("Цена*:",self.pr)
        self.un=QLineEdit(p["unit"] if p and p["unit"] else ""); F.addRow("Ед.изм.:",self.un)
        self.qy=QLineEdit(str(p["quantity"]) if p else "0"); F.addRow("Количество*:",self.qy)
        self.di=QLineEdit(str(p["discount"]) if p else "0"); F.addRow("Скидка %:",self.di)
        self.de=QLineEdit(p["description"] if p and p["description"] else ""); F.addRow("Описание:",self.de)
        self.cc=QComboBox(); [self.cc.addItem(r["name"],r["id"]) for r in run("SELECT id,name FROM categories")]
        self.mc=QComboBox(); [self.mc.addItem(r["name"],r["id"]) for r in run("SELECT id,name FROM manufacturers")]
        self.sc=QComboBox(); [self.sc.addItem(r["name"],r["id"]) for r in run("SELECT id,name FROM suppliers")]
        if p:
            for cb,k in ((self.cc,"category_id"),(self.mc,"manufacturer_id"),(self.sc,"supplier_id")):
                i=cb.findData(p[k]);
                if i>=0: cb.setCurrentIndex(i)
        F.addRow("Категория:",self.cc); F.addRow("Производитель:",self.mc); F.addRow("Поставщик:",self.sc)
        self.pl=QLabel("Нет фото"); self.pl.setFixedSize(150,100); self.pl.setAlignment(Qt.AlignmentFlag.AlignCenter); self.pl.setStyleSheet("border:1px solid gray")
        if p and p["image_path"]:
            px=QPixmap(p["image_path"])
            if not px.isNull(): self.pl.setPixmap(px.scaled(150,100,Qt.AspectRatioMode.KeepAspectRatio))
        bp=QPushButton("Фото"); bp.clicked.connect(self.photo)
        F.addRow("Фото:",self.pl); F.addRow("",bp); L.addLayout(F)
        bs=QPushButton("Сохранить"); bs.clicked.connect(self.save)
        bc=QPushButton("Отмена"); bc.clicked.connect(self.reject)
        h=QHBoxLayout(); h.addWidget(bs); h.addWidget(bc); L.addLayout(h)

    def photo(self):
        path,_=QFileDialog.getOpenFileName(self,"Фото","","Images (*.jpg *.png *.bmp)")
        if not path: return
        from PIL import Image
        img=Image.open(path).resize((300,200)); os.makedirs("images",exist_ok=True)
        save=os.path.join("images",os.path.basename(path)); img.save(save)
        if self.img and self.img!=save and os.path.exists(self.img):
            try: os.remove(self.img)
            except: pass
        self.img=save; self.pl.setPixmap(QPixmap(save).scaled(150,100,Qt.AspectRatioMode.KeepAspectRatio))

    def save(self):
        n=self.n.text().strip()
        if not n: QMessageBox.critical(self,"Ошибка","Введите название."); return
        try: p=float(self.pr.text()); assert p>=0
        except: QMessageBox.critical(self,"Ошибка","Цена >= 0."); return
        try: q=int(self.qy.text()); assert q>=0
        except: QMessageBox.critical(self,"Ошибка","Количество >= 0."); return
        d=(n,self.cc.currentData(),self.mc.currentData(),self.sc.currentData(),p,self.un.text().strip(),q,float(self.di.text() or 0),self.img,self.de.text().strip())
        if self.p: run("UPDATE products SET name=%s,category_id=%s,manufacturer_id=%s,supplier_id=%s,price=%s,unit=%s,quantity=%s,discount=%s,image_path=%s,description=%s WHERE id=%s",d+(self.p["id"],))
        else: run("INSERT INTO products(name,category_id,manufacturer_id,supplier_id,price,unit,quantity,discount,image_path,description)VALUES(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)",d)
        self.parent().load(); self.accept()

class Orders(QDialog):
    def __init__(self, parent):
        super().__init__(parent); self.pw=parent
        self.setWindowTitle("Заказы"); self.resize(700,400)
        L=QVBoxLayout(self)
        if parent.user["role"]=="admin":
            h=QHBoxLayout()
            ba=QPushButton("Добавить"); ba.clicked.connect(self.add)
            bd=QPushButton("Удалить"); bd.clicked.connect(self.delete)
            h.addWidget(ba); h.addWidget(bd); h.addStretch(); L.addLayout(h)
        self.t=QTableWidget(0,5)
        self.t.setHorizontalHeaderLabels(["Артикул","Статус","Адрес","Дата заказа","Дата выдачи"])
        self.t.setEditTriggers(QTableWidget.EditTrigger.NoEditTriggers)
        self.t.setSelectionBehavior(QTableWidget.SelectionBehavior.SelectRows)
        self.t.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.Stretch)
        L.addWidget(self.t)
        L.addWidget(QPushButton("Назад", clicked=self.close))
        self.load()

    def load(self):
        self.t.setRowCount(0)
        for r in run("SELECT o.*,s.name AS status FROM orders o LEFT JOIN order_statuses s ON o.status_id=s.id"):
            i=self.t.rowCount(); self.t.insertRow(i)
            for j,v in enumerate([r["article"],r["status"],r["pickup_address"],str(r["order_date"] or ""),str(r["delivery_date"] or "")]):
                it=QTableWidgetItem(str(v) if v else ""); it.setFlags(it.flags()&~Qt.ItemFlag.ItemIsEditable); self.t.setItem(i,j,it)
            self.t.item(i,0).setData(Qt.ItemDataRole.UserRole,r["id"])

    def add(self): OrderForm(self).exec(); self.load()

    def delete(self):
        sel=self.t.selectedItems()
        if not sel: return
        oid=self.t.item(sel[0].row(),0).data(Qt.ItemDataRole.UserRole)
        if QMessageBox.question(self,"?","Удалить заказ?") == QMessageBox.StandardButton.Yes:
            run("DELETE FROM order_items WHERE order_id=%s",(oid,))
            run("DELETE FROM orders WHERE id=%s",(oid,))
            self.load()

class OrderForm(QDialog):
    def __init__(self, parent):
        super().__init__(parent); self.setWindowTitle("Заказ"); self.setFixedSize(320,250)
        L=QVBoxLayout(self); F=QFormLayout()
        self.a=QLineEdit(); self.ad=QLineEdit(); self.od=QLineEdit("2024-01-01"); self.dd=QLineEdit("2024-01-07")
        self.st=QComboBox(); [self.st.addItem(r["name"],r["id"]) for r in run("SELECT id,name FROM order_statuses")]
        for lbl,w in [("Артикул*:",self.a),("Статус:",self.st),("Адрес:",self.ad),("Дата заказа:",self.od),("Дата выдачи:",self.dd)]: F.addRow(lbl,w)
        L.addLayout(F)
        bs=QPushButton("Сохранить"); bs.clicked.connect(self.save)
        bc=QPushButton("Отмена"); bc.clicked.connect(self.reject)
        h=QHBoxLayout(); h.addWidget(bs); h.addWidget(bc); L.addLayout(h)

    def save(self):
        if not self.a.text().strip(): QMessageBox.critical(self,"Ошибка","Введите артикул."); return
        run("INSERT INTO orders(article,status_id,pickup_address,order_date,delivery_date)VALUES(%s,%s,%s,%s,%s)",(self.a.text().strip(),self.st.currentData(),self.ad.text().strip(),self.od.text(),self.dd.text()))
        self.accept()

