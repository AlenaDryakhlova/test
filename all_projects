from PyQt6.QtWidgets import *
from PyQt6.QtGui import QPixmap
from PyQt6.QtCore import Qt
from config.database import run
from ui.product_form import Form
from ui.orders_dialog import Orders
import os


class Main(QMainWindow):
    def __init__(self, user, login):
        super().__init__()
        self.user = user
        self.login = login
        self.form = None
        self.sid = None
        self.all = []
        self.rev = False
        self.setWindowTitle(f"Магазин обуви — {user['role']}")
        self.resize(1000, 600)
        self.init_ui()
        self.load()

    def init_ui(self):
        # Toolbar
        tb = self.addToolBar("t")
        tb.setMovable(False)
        sp = QWidget()
        sp.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)
        tb.addWidget(sp)
        tb.addWidget(QLabel(f"  {self.user['full_name']}  "))
        bo = QPushButton("Выйти")
        bo.clicked.connect(self.logout)
        tb.addWidget(bo)

        # Central widget
        c = QWidget()
        self.setCentralWidget(c)
        L = QVBoxLayout(c)

        # Поиск, фильтрация и сортировка - для admin и manager
        if self.user["role"] in ("admin", "manager"):
            row = QHBoxLayout()
            self.se = QLineEdit(placeholderText="Поиск...")
            self.se.textChanged.connect(self.filt)
            row.addWidget(self.se)

            self.cb = QComboBox()
            self.cb.currentTextChanged.connect(self.filt)
            row.addWidget(self.cb)

            for t, r in [("↑", False), ("↓", True)]:
                b = QPushButton(f"Кол-во {t}")
                b.clicked.connect(lambda _, x=r: self.sort(x))
                row.addWidget(b)
            row.addStretch()
            L.addLayout(row)

        # Кнопки управления товарами - ТОЛЬКО для admin
        if self.user["role"] == "admin":
            row2 = QHBoxLayout()
            for t, fn in [("Добавить", lambda: self.edit(None)),
                          ("Редактировать", lambda: self.edit(self.sid)),
                          ("Удалить", self.delete)]:
                b = QPushButton(t)
                b.clicked.connect(fn)
                row2.addWidget(b)
            row2.addStretch()
            L.addLayout(row2)

        # Кнопка "Заказы" - для admin и manager
        if self.user["role"] in ("admin", "manager"):
            row3 = QHBoxLayout()
            b_orders = QPushButton("Заказы")
            b_orders.clicked.connect(lambda: Orders(self).exec())
            row3.addWidget(b_orders)
            row3.addStretch()
            L.addLayout(row3)

        # Product list
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        self.box = QWidget()
        self.bl = QVBoxLayout(self.box)
        self.bl.setSpacing(6)
        self.bl.addStretch()
        sc.setWidget(self.box)
        L.addWidget(sc)

    def load(self):
        self.all = run(
            "SELECT p.*,c.name AS category,m.name AS manufacturer,s.name AS supplier FROM products p LEFT JOIN categories c ON p.category_id=c.id LEFT JOIN manufacturers m ON p.manufacturer_id=m.id LEFT JOIN suppliers s ON p.supplier_id=s.id ORDER BY p.id")

        # Заполняем комбобокс только для admin/manager
        if self.user["role"] in ("admin", "manager"):
            sups = ["Все поставщики"] + sorted({r["supplier"] for r in self.all if r["supplier"]})
            self.cb.blockSignals(True)
            self.cb.clear()
            self.cb.addItems(sups)
            self.cb.blockSignals(False)

        self.filt()

    def filt(self):
        # Для client и guest - показываем все товары без фильтрации и сортировки
        if self.user["role"] in ("client", "guest"):
            res = self.all.copy()
        else:
            # Для admin/manager - применяем поиск и фильтр
            s = self.se.text().lower()
            sup = self.cb.currentText()
            res = [r for r in self.all if (not s or any(s in str(v).lower() for v in r.values())) and (
                        sup == "Все поставщики" or r["supplier"] == sup)]
            res.sort(key=lambda r: r["quantity"] or 0, reverse=self.rev)

        # Очищаем список
        while self.bl.count() > 1:
            w = self.bl.takeAt(0).widget()
            if w:
                w.deleteLater()

        # Добавляем карточки товаров
        for r in res:
            card = self.create_product_card(r)
            self.bl.insertWidget(self.bl.count() - 1, card)

    def create_product_card(self, r):
        d = float(r["discount"] or 0)
        q = int(r["quantity"] or 0)
        p = float(r["price"] or 0)

        card = QFrame()
        card.setFixedHeight(160)
        card.setFrameShape(QFrame.Shape.Box)
        if q == 0:
            card.setStyleSheet("background:#ADD8E6")
        elif d > 15:
            card.setStyleSheet("background:#2E8B57")
        else:
            card.setStyleSheet("background:white")

        h = QHBoxLayout(card)
        h.setContentsMargins(8, 8, 8, 8)

        # Image
        ph = QLabel()
        ph.setFixedSize(140, 140)
        ph.setAlignment(Qt.AlignmentFlag.AlignCenter)
        ph.setStyleSheet("border:1px solid gray;background:white")
        img = r["image_path"] if r["image_path"] and os.path.exists(r["image_path"]) else "images/picture.png"
        px = QPixmap(img)
        if not px.isNull():
            ph.setPixmap(px.scaled(140, 140, Qt.AspectRatioMode.KeepAspectRatio))
        else:
            ph.setText("Фото")
        h.addWidget(ph)

        # Info
        tc = "white" if d > 15 and q > 0 else "black"
        info = QVBoxLayout()
        info.setSpacing(2)
        texts = [
            f"<b>{r['category']} | {r['name']}</b>",
            f"Описание: {r['description'] or '—'}",
            f"Производитель: {r['manufacturer'] or '—'}",
            f"Поставщик: {r['supplier'] or '—'}",
            f"Цена: <s style='color:red'>{p}</s> <b>{round(p * (1 - d / 100), 2)}</b>" if d > 0 else f"Цена: <b>{p}</b>",
            f"Ед. изм.: {r['unit'] or '—'}",
            f"На складе: {q}"
        ]
        for txt in texts:
            l = QLabel(txt)
            l.setStyleSheet(f"color:{tc};border:none")
            info.addWidget(l)
        h.addLayout(info, 1)

        # Discount
        dl = QLabel(f"{int(d)}%" if d else "—")
        dl.setFixedSize(120, 140)
        dl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        dl.setStyleSheet("border:1px solid gray;font-size:22px;font-weight:bold;background:white;color:black")
        h.addWidget(dl)

        # Выделение товара - только для admin (кто может редактировать)
        if self.user["role"] == "admin":
            rid = r["id"]
            card.mousePressEvent = lambda e, i=rid: setattr(self, "sid", i)

        return card

    def sort(self, rev):
        self.rev = rev
        self.filt()

    def edit(self, pid):
        if self.form:
            QMessageBox.warning(self, "!", "Форма уже открыта.")
            self.form.activateWindow()
            return
        if pid and not any(r["id"] == pid for r in self.all):
            QMessageBox.information(self, "i", "Выберите товар.")
            return
        prod = next((r for r in self.all if r["id"] == pid), None) if pid else None
        self.form = Form(self, prod)
        self.form.show()

    def delete(self):
        if not self.sid:
            QMessageBox.information(self, "i", "Выберите товар.")
            return
        if run("SELECT COUNT(*) AS c FROM order_items WHERE product_id=%s", (self.sid,), one=True)["c"]:
            QMessageBox.critical(self, "!", "Товар есть в заказах.")
            return
        if QMessageBox.question(self, "?", "Удалить товар?") == QMessageBox.StandardButton.Yes:
            run("DELETE FROM products WHERE id=%s", (self.sid,))
            self.sid = None
            self.load()

    def logout(self):
        self.close()
        self.login.lg.clear()
        self.login.pw.clear()
        self.login.show()

