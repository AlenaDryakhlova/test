from PIL import Image


class Form(QDialog):
    def __init__(self, parent, p=None):
        super().__init__(parent)
        self.p = p
        self.img = p["image_path"] if p else None
        self.parent_window = parent
        self.setWindowTitle("Товар")
        self.setMinimumWidth(400)
        self.finished.connect(lambda: setattr(parent, "form", None))
        self.init_ui()

    def init_ui(self):
        L = QVBoxLayout(self)
        F = QFormLayout()

        if self.p:
            id_f = QLineEdit(str(self.p["id"]))
            id_f.setReadOnly(True)
            F.addRow("ID:", id_f)

        self.n = QLineEdit(self.p["name"] if self.p else "")
        F.addRow("Название*:", self.n)

        self.pr = QLineEdit(str(self.p["price"]) if self.p else "")
        F.addRow("Цена*:", self.pr)

        self.un = QLineEdit(self.p["unit"] if self.p and self.p["unit"] else "")
        F.addRow("Ед.изм.:", self.un)

        self.qy = QLineEdit(str(self.p["quantity"]) if self.p else "0")
        F.addRow("Количество*:", self.qy)

        self.di = QLineEdit(str(self.p["discount"]) if self.p else "0")
        F.addRow("Скидка %:", self.di)

        self.de = QLineEdit(self.p["description"] if self.p and self.p["description"] else "")
        F.addRow("Описание:", self.de)

        # ComboBoxes
        self.cc = QComboBox()
        [self.cc.addItem(r["name"], r["id"]) for r in run("SELECT id,name FROM categories")]

        self.mc = QComboBox()
        [self.mc.addItem(r["name"], r["id"]) for r in run("SELECT id,name FROM manufacturers")]

        self.sc = QComboBox()
        [self.sc.addItem(r["name"], r["id"]) for r in run("SELECT id,name FROM suppliers")]

        if self.p:
            for cb, k in ((self.cc, "category_id"), (self.mc, "manufacturer_id"), (self.sc, "supplier_id")):
                i = cb.findData(self.p[k])
                if i >= 0:
                    cb.setCurrentIndex(i)

        F.addRow("Категория:", self.cc)
        F.addRow("Производитель:", self.mc)
        F.addRow("Поставщик:", self.sc)

        # Photo
        self.pl = QLabel("Нет фото")
        self.pl.setFixedSize(150, 100)
        self.pl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.pl.setStyleSheet("border:1px solid gray")

        if self.p and self.p["image_path"]:
            px = QPixmap(self.p["image_path"])
            if not px.isNull():
                self.pl.setPixmap(px.scaled(150, 100, Qt.AspectRatioMode.KeepAspectRatio))

        bp = QPushButton("Фото")
        bp.clicked.connect(self.photo)
        F.addRow("Фото:", self.pl)
        F.addRow("", bp)
        L.addLayout(F)

        # Buttons
        bs = QPushButton("Сохранить")
        bs.clicked.connect(self.save)
        bc = QPushButton("Отмена")
        bc.clicked.connect(self.reject)
        h = QHBoxLayout()
        h.addWidget(bs)
        h.addWidget(bc)
        L.addLayout(h)

    def photo(self):
        path, _ = QFileDialog.getOpenFileName(self, "Фото", "", "Images (*.jpg *.png *.bmp)")
        if not path:
            return

        img = Image.open(path).resize((300, 200))
        os.makedirs("images", exist_ok=True)
        save = os.path.join("images", os.path.basename(path))
        img.save(save)

        if self.img and self.img != save and os.path.exists(self.img):
            try:
                os.remove(self.img)
            except:
                pass

        self.img = save
        self.pl.setPixmap(QPixmap(save).scaled(150, 100, Qt.AspectRatioMode.KeepAspectRatio))

    def save(self):
        n = self.n.text().strip()
        if not n:
            QMessageBox.critical(self, "Ошибка", "Введите название.")
            return

        try:
            p = float(self.pr.text())
            assert p >= 0
        except:
            QMessageBox.critical(self, "Ошибка", "Цена >= 0.")
            return

        try:
            q = int(self.qy.text())
            assert q >= 0
        except:
            QMessageBox.critical(self, "Ошибка", "Количество >= 0.")
            return

        d = (
            n, self.cc.currentData(), self.mc.currentData(), self.sc.currentData(),
            p, self.un.text().strip(), q, float(self.di.text() or 0), self.img, self.de.text().strip()
        )

        if self.p:
            run("UPDATE products SET name=%s,category_id=%s,manufacturer_id=%s,supplier_id=%s,price=%s,unit=%s,quantity=%s,discount=%s,image_path=%s,description=%s WHERE id=%s",
                d + (self.p["id"],))
        else:
            run("INSERT INTO products(name,category_id,manufacturer_id,supplier_id,price,unit,quantity,discount,image_path,description) VALUES(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)",
                d)

        self.parent_window.load()
        self.accept()

