import pymysql
from pymysql.cursors import DictCursor

DB_CONFIG = {'host': 'localhost', 'user': 'root', 'password': '12345', 'database': 'shoes_store', 'charset': 'utf8mb4', 'cursorclass': DictCursor}

def get_conn():
    return pymysql.connect(**DB_CONFIG)

def get_user(login, password):
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                SELECT u.id, u.full_name, r.name AS role
                FROM users u JOIN roles r ON u.role_id = r.id
                WHERE u.login = %s AND u.password = %s
            """, (login, password))
            return cur.fetchone()

def get_products(search='', supplier_id=None, sort=None):
    with get_conn() as conn:
        with conn.cursor() as cur:
            sql = """
                SELECT p.*, c.name AS category, m.name AS manufacturer, s.name AS supplier
                FROM products p
                JOIN categories c ON p.category_id = c.id
                JOIN manufacturers m ON p.manufacturer_id = m.id
                JOIN suppliers s ON p.supplier_id = s.id
            """
            params = []
            if search:
                sql += " WHERE (p.name LIKE %s OR p.description LIKE %s OR p.article LIKE %s)"
                params = [f'%{search}%'] * 3
            if supplier_id:
                sql += " AND p.supplier_id = %s" if 'WHERE' in sql else " WHERE p.supplier_id = %s"
                params.append(supplier_id)
            if sort == 'asc':
                sql += " ORDER BY p.quantity ASC"
            elif sort == 'desc':
                sql += " ORDER BY p.quantity DESC"
            cur.execute(sql, params)
            return cur.fetchall()

def get_product(product_id):
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT * FROM products WHERE id = %s", (product_id,))
            return cur.fetchone()

def save_product(data, product_id=None):
    with get_conn() as conn:
        with conn.cursor() as cur:
            if product_id:
                sql = """UPDATE products SET article=%s, name=%s, unit=%s, price=%s,
                         supplier_id=%s, manufacturer_id=%s, category_id=%s,
                         discount=%s, quantity=%s, description=%s, photo=%s WHERE id=%s"""
                cur.execute(sql, (*data.values(), product_id))
            else:
                sql = """INSERT INTO products (article, name, unit, price, supplier_id,
                         manufacturer_id, category_id, discount, quantity, description, photo)
                         VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)"""
                cur.execute(sql, tuple(data.values()))
            conn.commit()

def delete_product(product_id):
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("DELETE FROM products WHERE id = %s", (product_id,))
            conn.commit()

def product_in_orders(article):
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT COUNT(*) as cnt FROM orders WHERE article LIKE %s", (f'%{article}%',))
            return cur.fetchone()['cnt'] > 0

def get_suppliers():
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT id, name FROM suppliers ORDER BY name")
            return cur.fetchall()

def get_categories():
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT id, name FROM categories ORDER BY name")
            return cur.fetchall()

def get_manufacturers():
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT id, name FROM manufacturers ORDER BY name")
            return cur.fetchall()

def get_orders():
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                SELECT o.*, pp.address AS pickup_address
                FROM orders o LEFT JOIN pickup_points pp ON o.pickup_point_id = pp.id
                ORDER BY o.id
            """)
            return cur.fetchall()

def get_order(order_id):
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT * FROM orders WHERE id = %s", (order_id,))
            return cur.fetchone()

def save_order(data, order_id=None):
    with get_conn() as conn:
        with conn.cursor() as cur:
            if order_id:
                sql = """UPDATE orders SET article=%s, order_date=%s, delivery_date=%s,
                         pickup_point_id=%s, client_name=%s, pickup_code=%s, status=%s WHERE id=%s"""
                cur.execute(sql, (*data.values(), order_id))
            else:
                sql = """INSERT INTO orders (article, order_date, delivery_date, pickup_point_id,
                         client_name, pickup_code, status) VALUES (%s, %s, %s, %s, %s, %s, %s)"""
                cur.execute(sql, tuple(data.values()))
            conn.commit()

def delete_order(order_id):
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("DELETE FROM orders WHERE id = %s", (order_id,))
            conn.commit()

def get_pickup_points():
