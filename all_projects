DB = dict(host="localhost", user="root", password="12345", database="shoes_store2", charset="utf8mb4", cursorclass=pymysql.cursors.DictCursor)

def run(sql, args=(), one=False):
    with pymysql.connect(**DB) as c:
        with c.cursor() as cur:
            cur.execute(sql, args)
            if sql.strip().upper().startswith("SELECT"): return cur.fetchone() if one else cur.fetchall()
        c.commit()

