        btn_layout.addWidget(btn_cancel)

        layout.addLayout(btn_layout)

    def set_stub_photo(self):
        stub = os.path.join(os.path.dirname(__file__), 'picture.png')
        if os.path.exists(stub):
            pix = QPixmap(stub).scaled(150, 100, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
            self.photo_label.setPixmap(pix)

    def choose_photo(self):
        path, _ = QFileDialog.getOpenFileName(self, 'Выберите фото', '', 'Images (*.png *.jpg *.jpeg)')
        if path:
            dest = os.path.join(os.path.dirname(__file__), os.path.basename(path))
            Image.open(path).resize((300, 200), Image.LANCZOS).save(dest)
            self.photo_path = os.path.basename(path)
            pix = QPixmap(dest).scaled(150, 100, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
            self.photo_label.setPixmap(pix)

    def load_data(self):
        p = db.get_product(self.product_id)
        if p:
            self.article.setText(p['article'])
            self.name.setText(p['name'])
            self.desc.setPlainText(p.get('description', ''))
            self.unit.setText(p['unit'])
            self.price.setValue(float(p['price']))
            self.quantity.setValue(p['quantity'])
            self.discount.setValue(p.get('discount', 0))

            for i in range(self.category.count()):
                if self.category.itemData(i) == p['category_id']:
                    self.category.setCurrentIndex(i)
                    break
            for i in range(self.manufacturer.count()):
                if self.manufacturer.itemData(i) == p['manufacturer_id']:
                    self.manufacturer.setCurrentIndex(i)
                    break
            for i in range(self.supplier.count()):
                if self.supplier.itemData(i) == p['supplier_id']:
                    self.supplier.setCurrentIndex(i)
                    break

            if p.get('photo'):
                self.photo_path = p['photo']
                path = os.path.join(os.path.dirname(__file__), p['photo'])
                if os.path.exists(path):
                    pix = QPixmap(path).scaled(150, 100, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
                    self.photo_label.setPixmap(pix)

    def save(self):
        if not self.article.text().strip() or not self.name.text().strip():
            QMessageBox.warning(self, 'Ошибка', 'Заполните артикул и наименование')
            return

        data = {
            'article': self.article.text().strip(),
            'name': self.name.text().strip(),
            'unit': self.unit.text().strip(),
            'price': self.price.value(),
            'supplier_id': self.supplier.currentData(),
            'manufacturer_id': self.manufacturer.currentData(),
            'category_id': self.category.currentData(),
            'discount': self.discount.value(),
            'quantity': self.quantity.value(),
            'description': self.desc.toPlainText().strip(),
            'photo': self.photo_path
        }
        db.save_product(data, self.product_id if self.is_edit else None)
        self.parent.load_products()
        self.accept()

