            ph=QLabel(); ph.setFixedSize(140,140); ph.setAlignment(Qt.AlignmentFlag.AlignCenter); ph.setStyleSheet("border:1px solid gray;background:white")
            img=r["image_path"] if r["image_path"] and os.path.exists(r["image_path"]) else "images/picture.png"
            px=QPixmap(img)
            if not px.isNull(): ph.setPixmap(px.scaled(140,140,Qt.AspectRatioMode.KeepAspectRatio))
            else: ph.setText("Фото")
            h.addWidget(ph)
            tc="white" if d>15 and q>0 else "black"
            info=QVBoxLayout(); info.setSpacing(2)
            for txt in [f"<b>{r['category']} | {r['name']}</b>",f"Описание: {r['description'] or '—'}",f"Производитель: {r['manufacturer'] or '—'}",f"Поставщик: {r['supplier'] or '—'}",f"Цена: <s style='color:red'>{p}</s> <b>{round(p*(1-d/100),2)}</b>" if d>0 else f"Цена: <b>{p}</b>",f"Ед. изм.: {r['unit'] or '—'}",f"На складе: {q}"]:
                l=QLabel(txt); l.setStyleSheet(f"color:{tc};border:none"); info.addWidget(l)
            h.addLayout(info,1)
            dl=QLabel(f"{int(d)}%" if d else "—"); dl.setFixedSize(120,140); dl.setAlignment(Qt.AlignmentFlag.AlignCenter); dl.setStyleSheet("border:1px solid gray;font-size:22px;font-weight:bold;background:white;color:black"); h.addWidget(dl)
            if self.user["role"] == "admin": rid=r["id"]; card.mousePressEvent=lambda e,i=rid: setattr(self,"sid",i)
            self.bl.insertWidget(self.bl.count()-1,card)

    def sort(self, rev): self.rev=rev; self.filt()

    def edit(self, pid):
        if self.form: QMessageBox.warning(self,"!","Форма уже открыта."); self.form.activateWindow(); return
        if pid and not any(r["id"]==pid for r in self.all): QMessageBox.information(self,"i","Выберите товар."); return
