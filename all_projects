class ProductItemWidget(QFrame):
    def __init__(self, product, user, parent):
        super().__init__()
        self.product = product
        self.user = user
        self.parent = parent
        discount = product.get('discount', 0) or 0
        bg = '#2E8B57' if discount > 15 else ('#ADD8E6' if product.get('quantity', 0) == 0 else 'white')
        self.setStyleSheet(f'QFrame {{ background: {bg}; border: 1px solid #CCC; border-radius: 4px; margin: 2px; }}')
