        btn_cancel.setStyleSheet(BTN_GRAY)
        btn_cancel.clicked.connect(self.reject)
        btn_layout.addWidget(btn_cancel)

        layout.addLayout(btn_layout)

    def load_data(self):
        order = db.get_order(self.order_id)
        if not order:
            return
        self.article.setText(order['article'])
        idx = self.status.findText(order['status'])
        if idx >= 0:
            self.status.setCurrentIndex(idx)
        for i in range(self.pickup.count()):
            if self.pickup.itemData(i) == order['pickup_point_id']:
                self.pickup.setCurrentIndex(i)
                break
        if order['order_date']:
            d = order['order_date']
            if hasattr(d, 'year'):
                self.order_date.setDate(QDate(d.year, d.month, d.day))
            else:
                parts = str(d)[:10].split('-')
                if len(parts) == 3:
                    self.order_date.setDate(QDate(int(parts[0]), int(parts[1]), int(parts[2])))
        if order['delivery_date']:
            d = order['delivery_date']
            if hasattr(d, 'year'):
                self.delivery_date.setDate(QDate(d.year, d.month, d.day))
            else:
                parts = str(d)[:10].split('-')
                if len(parts) == 3:
                    self.delivery_date.setDate(QDate(int(parts[0]), int(parts[1]), int(parts[2])))

    def save(self):
        if not self.article.text().strip():
            QMessageBox.warning(self, 'Ошибка', 'Введите артикул')
            return

        data = {
            'article': self.article.text().strip(),
            'status': self.status.currentText(),
            'pickup_point_id': self.pickup.currentData(),
            'order_date': self.order_date.date().toString('yyyy-MM-dd'),
            'delivery_date': self.delivery_date.date().toString('yyyy-MM-dd'),
            'client_name': '',
            'pickup_code': ''
        }
        db.save_order(data, self.order_id if self.is_edit else None)
        QMessageBox.information(self, 'Успех', 'Заказ сохранен')
        self.parent.load_orders()
        self.accept()

