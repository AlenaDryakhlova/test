            filter_layout = QHBoxLayout()
            self.search_input = QLineEdit()
            self.search_input.setPlaceholderText('Поиск...')
            self.search_input.textChanged.connect(lambda: self.timer.start(300))
            filter_layout.addWidget(self.search_input, 2)

            self.supplier_combo = QComboBox()
            self.supplier_combo.addItem('Все поставщики', None)
            for s in db.get_suppliers():
                self.supplier_combo.addItem(s['name'], s['id'])
            self.supplier_combo.currentIndexChanged.connect(lambda: self.timer.start(300))
            filter_layout.addWidget(self.supplier_combo, 1)

            self.sort_combo = QComboBox()
            self.sort_combo.addItems(['Без сортировки', 'Кол-во ↑', 'Кол-во ↓'])
            self.sort_combo.currentIndexChanged.connect(lambda: self.timer.start(300))
            filter_layout.addWidget(self.sort_combo, 1)
