            photo.setPixmap(pix)
        layout.addWidget(photo)

        # Инфо
        p = self.product
        price = float(p['price'])
        final = price * (1 - (p.get('discount', 0) or 0) / 100)
        price_html = f'<span style="color:red;text-decoration:line-through">{price:.2f} руб.</span> <b>{final:.2f} руб.</b>' if p.get('discount') else f'{price:.2f} руб.'
