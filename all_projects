from PyQt6.QtCore import Qt
from PyQt6.QtGui import QFont
from PyQt6.QtWidgets import *
import db

class LoginWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle('Авторизация — ООО "Обувь"')
        self.setMinimumSize(400, 450)
        self.setup_ui()

    def setup_ui(self):
        central = QWidget()
        central.setStyleSheet('background: white;')
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)
        layout.setContentsMargins(40, 30, 40, 30)
        layout.setSpacing(12)

        # Логотип
        logo = QLabel('ООО "Обувь"')
        logo.setAlignment(Qt.AlignmentFlag.AlignCenter)
        logo.setFont(QFont('Times New Roman', 18, QFont.Weight.Bold))
        layout.addWidget(logo)

        line = QFrame()
        line.setFrameShape(QFrame.Shape.HLine)
        line.setStyleSheet('color:#AAA;')
        layout.addWidget(line)

        title = QLabel('Вход в систему')
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        title.setFont(QFont('Times New Roman', 15, QFont.Weight.Bold))
        layout.addWidget(title)

        self.input_login = QLineEdit()
        self.input_login.setPlaceholderText('Введите логин')
        self.input_login.setFixedHeight(32)
        layout.addWidget(self.input_login)

        self.input_password = QLineEdit()
        self.input_password.setEchoMode(QLineEdit.EchoMode.Password)
        self.input_password.setPlaceholderText('Введите пароль')
        self.input_password.setFixedHeight(32)
        self.input_password.returnPressed.connect(self.login)
        layout.addWidget(self.input_password)

        layout.addSpacing(10)

        btn_login = QPushButton('Войти')
        btn_login.setStyleSheet('QPushButton { background: #00FA9A; padding: 8px; border-radius: 4px; }')
        btn_login.clicked.connect(self.login)
        layout.addWidget(btn_login)

        btn_guest = QPushButton('Войти как гость')
        btn_guest.setStyleSheet('QPushButton { background: #7FFF00; padding: 8px; border-radius: 4px; }')
        btn_guest.clicked.connect(lambda: self.open_products(None))
        layout.addWidget(btn_guest)

    def login(self):
        login = self.input_login.text().strip()
        password = self.input_password.text().strip()
        if not login or not password:
            QMessageBox.warning(self, 'Ошибка', 'Введите логин и пароль')
            return
        try:
            user = db.get_user(login, password)
        except Exception as e:
            QMessageBox.critical(self, 'Ошибка', f'Ошибка БД: {e}')
            return
        if not user:
            QMessageBox.warning(self, 'Ошибка', 'Неверный логин или пароль')
            self.input_password.clear()
            return
        self.open_products(user)

    def open_products(self, user):
        from products_window import ProductsWindow
        self.products_window = ProductsWindow(user, self)
        self.products_window.show()
        self.hide()

