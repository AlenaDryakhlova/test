        self.list_layout.setSpacing(4)
        scroll.setWidget(self.list_widget)
        layout.addWidget(scroll)

        self.edit_window = None

    def load_products(self):
        search = self.search_input.text() if hasattr(self, 'search_input') else ''
        supplier = self.supplier_combo.currentData() if hasattr(self, 'supplier_combo') else None
        sort_index = self.sort_combo.currentIndex() if hasattr(self, 'sort_combo') else 0
        sort = ['', 'asc', 'desc'][sort_index] if sort_index > 0 else None

        products = db.get_products(search, supplier, sort)

        # Очистка
        while self.list_layout.count():
            w = self.list_layout.takeAt(0).widget()
            if w: w.deleteLater()

        if not products:
            lbl = QLabel('Товары не найдены')
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.list_layout.addWidget(lbl)
        else:
            for p in products:
                self.list_layout.addWidget(ProductItemWidget(p, self.user, self))

    def open_product_form(self, product_id=None):
        if self.edit_window and self.edit_window.isVisible():
            QMessageBox.information(self, 'Внимание', 'Окно редактирования уже открыто')
            self.edit_window.activateWindow()
            return
        from product_form import ProductFormWindow
        self.edit_window = ProductFormWindow(product_id, self)
        self.edit_window.show()

    def open_orders(self):
