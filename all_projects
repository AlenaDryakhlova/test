    def load(self):
        self.all = run("SELECT p.*,c.name AS category,m.name AS manufacturer,s.name AS supplier FROM products p LEFT JOIN categories c ON p.category_id=c.id LEFT JOIN manufacturers m ON p.manufacturer_id=m.id LEFT JOIN suppliers s ON p.supplier_id=s.id ORDER BY p.id")
        if self.user["role"] in ("admin","manager"):
            sups = ["Все поставщики"]+sorted({r["supplier"] for r in self.all if r["supplier"]})
            self.cb.blockSignals(True); self.cb.clear(); self.cb.addItems(sups); self.cb.blockSignals(False)
        self.filt()

    def filt(self):
        if self.user["role"] in ("client","guest"):
            res = self.all.copy()
        else:
            s = self.se.text().lower(); sup = self.cb.currentText()
            res = [r for r in self.all if (not s or any(s in str(v).lower() for v in r.values())) and (sup=="Все поставщики" or r["supplier"]==sup)]
            res.sort(key=lambda r: r["quantity"] or 0, reverse=self.rev)
        while self.bl.count()>1: w=self.bl.takeAt(0).widget(); w and w.deleteLater()
        for r in res:
            d=float(r["discount"] or 0); q=int(r["quantity"] or 0); p=float(r["price"] or 0)
            card=QFrame(); card.setFixedHeight(160); card.setFrameShape(QFrame.Shape.Box)
            card.setStyleSheet("background:#ADD8E6" if q==0 else ("background:#2E8B57" if d>15 else "background:white"))
