from PyQt6.QtWidgets import *
from PyQt6.QtCore import Qt, QDate
from PyQt6.QtGui import QFont
import db

BTN_STYLE = 'QPushButton { padding: 6px 14px; border-radius: 4px; font-size: 11px; } QPushButton:hover { opacity: 0.8; }'
BTN_GREEN = f'QPushButton {{ background-color: #00FA9A; border: 1px solid #999; {BTN_STYLE} }}'
BTN_GRAY = f'QPushButton {{ background-color: #EEEEEE; border: 1px solid #999; {BTN_STYLE} }}'

STATUSES = ['Новый', 'В обработке', 'Отправлен', 'Завершен', 'Отменен']

class OrderFormWindow(QDialog):
    def __init__(self, order_id, parent):
        super().__init__(parent)
        self.order_id = order_id
        self.parent = parent
        self.is_edit = order_id is not None
        self.setWindowTitle('Редактирование заказа' if self.is_edit else 'Добавление заказа')
        self.setMinimumSize(500, 400)
        self.setModal(True)
        self.setup_ui()
        if self.is_edit:
            self.load_data()

    def setup_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 16, 20, 16)

        title = QLabel(self.windowTitle())
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        title.setFont(QFont('Times New Roman', 14, QFont.Weight.Bold))
        layout.addWidget(title)

        form = QFormLayout()
        form.setSpacing(10)
        font = QFont('Times New Roman', 11)

        self.article = QLineEdit()
        self.article.setPlaceholderText('Например: А112Т4, 2, F635R4, 1')
        self.article.setFont(font)
        form.addRow('Артикул:', self.article)

        self.status = QComboBox()
        for s in STATUSES:
            self.status.addItem(s)
        form.addRow('Статус:', self.status)

        self.pickup = QComboBox()
        for pp in db.get_pickup_points():
            self.pickup.addItem(pp['address'], pp['id'])
        form.addRow('Пункт выдачи:', self.pickup)

        self.order_date = QDateEdit()
        self.order_date.setDate(QDate.currentDate())
