        self.photo_label.setFixedSize(150, 100)
        self.photo_label.setStyleSheet('border: 1px solid #aaa; background: #f5f5f5;')
        stub = os.path.join(os.path.dirname(__file__), 'picture.png')
        if os.path.exists(stub):
            self.photo_label.setPixmap(QPixmap(stub).scaled(150, 100, Qt.AspectRatioMode.KeepAspectRatio))
        else:
            self.photo_label.setText('Нет фото')

        # Кнопка выбора фото
        self.btn_photo = QPushButton('Выбрать фото')
        self.btn_photo.setFont(font)
        self.btn_photo.clicked.connect(self._choose_photo)

        # Если режим редактирования - отключаем кнопку выбора фото
        if self.is_edit:
            self.btn_photo.setEnabled(False)
            self.btn_photo.setStyleSheet(
                db.STYLES['btn_neutral'] + 'QPushButton:disabled { background-color: #cccccc; color: #666666; }')

        photo_row = QHBoxLayout()
        photo_row.addWidget(self.photo_label)
        photo_row.addWidget(self.btn_photo)
        photo_row.addStretch()
        form.addRow('Фото:', photo_row)

        self.input_article = QLineEdit()
        self.input_article.setFont(font)
        form.addRow('Артикул:', self.input_article)

        self.input_name = QLineEdit()
        self.input_name.setFont(font)
        form.addRow('Наименование:', self.input_name)

        self.combo_category = QComboBox()
        self.combo_category.setFont(font)
        for cat in db.get_categories():
            self.combo_category.addItem(cat['name'], cat['id'])
        form.addRow('Категория:', self.combo_category)

        self.input_desc = QTextEdit()
        self.input_desc.setFont(font)
        self.input_desc.setFixedHeight(70)
        form.addRow('Описание:', self.input_desc)

        self.combo_manufacturer = QComboBox()
        self.combo_manufacturer.setFont(font)
        for man in db.get_manufacturers():
            self.combo_manufacturer.addItem(man['name'], man['id'])
        form.addRow('Производитель:', self.combo_manufacturer)

        self.combo_supplier = QComboBox()
        self.combo_supplier.setFont(font)
        for sup in db.get_suppliers():
            self.combo_supplier.addItem(sup['name'], sup['id'])
        form.addRow('Поставщик:', self.combo_supplier)

        self.input_price = QDoubleSpinBox()
        self.input_price.setFont(font)
        self.input_price.setRange(0, 9999999.99)
        self.input_price.setSuffix(' руб.')
        form.addRow('Цена:', self.input_price)

        self.input_unit = QLineEdit()
        self.input_unit.setFont(font)
        form.addRow('Единица измерения:', self.input_unit)

        self.input_qty = QSpinBox()
        self.input_qty.setFont(font)
        self.input_qty.setRange(0, 999999)
        form.addRow('Кол-во на складе:', self.input_qty)

        self.input_discount = QSpinBox()
        self.input_discount.setFont(font)
        self.input_discount.setRange(0, 100)
        self.input_discount.setSuffix('%')
        form.addRow('Скидка:', self.input_discount)

        scroll.setWidget(content)
        layout.addWidget(scroll)

        btn_bar = QHBoxLayout()
        btn_save = QPushButton('Сохранить')
        btn_save.setStyleSheet(db.STYLES['btn_accent'])
        btn_save.clicked.connect(self._save)
        btn_cancel = QPushButton('Отмена')
        btn_cancel.setStyleSheet(db.STYLES['btn_neutral'])
        btn_cancel.clicked.connect(self.reject)
        btn_bar.addWidget(btn_save)
        btn_bar.addWidget(btn_cancel)
        layout.addLayout(btn_bar)

    def _choose_photo(self):
        path, _ = QFileDialog.getOpenFileName(self, 'Выберите фото', '', 'Images (*.png *.jpg *.jpeg)')
        if not path:
            return
        dest = os.path.join(os.path.dirname(__file__), os.path.basename(path))
        shutil.copy2(path, dest)
        # Удаляем старое фото если оно отличается от нового
        if self.photo_path and os.path.exists(self.photo_path) and self.photo_path != dest:
            try:
                os.remove(self.photo_path)
            except OSError:
                pass
        self.photo_path = dest
        self.photo_label.setPixmap(QPixmap(dest).scaled(150, 100, Qt.AspectRatioMode.KeepAspectRatio))

    def _load_data(self):
        product = db.get_item_by_id('products', self.product_id)
        if not product:
            return
        self.input_article.setText(product.get('article', ''))
        self.input_name.setText(product.get('name', ''))
        self.input_desc.setPlainText(product.get('description', '') or '')
        self.input_unit.setText(product.get('unit', ''))
        self.input_price.setValue(float(product.get('price', 0)))
        self.input_qty.setValue(int(product.get('quantity', 0)))
        self.input_discount.setValue(int(product.get('discount', 0)))

        for combo, key in [(self.combo_category, 'category_id'),
                           (self.combo_manufacturer, 'manufacturer_id'),
                           (self.combo_supplier, 'supplier_id')]:
            for i in range(combo.count()):
                if combo.itemData(i) == product.get(key):
                    combo.setCurrentIndex(i)
                    break

        photo = product.get('photo', '')
        if photo and os.path.exists(photo):
            self.photo_path = photo
            self.photo_label.setPixmap(QPixmap(photo).scaled(150, 100, Qt.AspectRatioMode.KeepAspectRatio))

    def _save(self):
        if not self.input_article.text().strip():
            QMessageBox.warning(self, 'Ошибка', 'Артикул не может быть пустым')
            return
        if not self.input_name.text().strip():
            QMessageBox.warning(self, 'Ошибка', 'Наименование не может быть пустым')
            return

        data = {
            'article': self.input_article.text().strip(),
            'name': self.input_name.text().strip(),
            'unit': self.input_unit.text().strip(),
            'price': self.input_price.value(),
            'supplier_id': self.combo_supplier.currentData(),
            'manufacturer_id': self.combo_manufacturer.currentData(),
            'category_id': self.combo_category.currentData(),
            'discount': self.input_discount.value(),
            'quantity': self.input_qty.value(),
            'description': self.input_desc.toPlainText().strip(),
            'photo': self.photo_path
        }

        try:
            if self.is_edit:
                db.update_item('products', self.product_id, data)
            else:
                db.add_item('products', data)
            QMessageBox.information(self, 'Успех', 'Товар сохранён')
            self.accept()
            self.parent().load_products()
        except Exception as e:
            QMessageBox.critical(self, 'Ошибка', f'Не удалось сохранить: {e}')

