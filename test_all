        if self.is_edit:
            self.load_data()

    def setup_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 16, 20, 16)

        # Заголовок
        title = QLabel('Редактирование заказа' if self.is_edit else 'Добавление заказа')
        title.setFont(QFont('Times New Roman', 14, QFont.Weight.Bold))
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        # Форма
        form = QFormLayout()
        form.setSpacing(10)
        font = QFont('Times New Roman', 11)

        # Артикул
        self.input_article = QLineEdit()
        self.input_article.setFont(font)
        self.input_article.setPlaceholderText('Например: А112Т4, 2, F635R4, 1')
        form.addRow('Артикул:', self.input_article)

        # Статус
        self.combo_status = QComboBox()
        self.combo_status.setFont(font)
        self.combo_status.addItems(STATUSES)
        form.addRow('Статус:', self.combo_status)

        # Пункт выдачи
        self.combo_pickup = QComboBox()
        self.combo_pickup.setFont(font)
        self.pickup_points = db.get_pickup_points()
        for pp in self.pickup_points:
            self.combo_pickup.addItem(pp['address'], pp['id'])
        form.addRow('Пункт выдачи:', self.combo_pickup)

        # Даты
        self.date_order = QDateEdit()
        self.date_order.setFont(font)
        self.date_order.setCalendarPopup(True)
        self.date_order.setDate(QDate.currentDate())
        self.date_order.setDisplayFormat('dd.MM.yyyy')
        form.addRow('Дата заказа:', self.date_order)

        self.date_delivery = QDateEdit()
        self.date_delivery.setFont(font)
        self.date_delivery.setCalendarPopup(True)
        self.date_delivery.setDate(QDate.currentDate())
        self.date_delivery.setDisplayFormat('dd.MM.yyyy')
        form.addRow('Дата выдачи:', self.date_delivery)

        layout.addLayout(form)
        layout.addStretch()

        # Кнопки
        btn_bar = QHBoxLayout()

        btn_save = QPushButton('Сохранить')
        btn_save.setStyleSheet(db.STYLES['btn_accent'])
        btn_save.clicked.connect(self.save)
        btn_bar.addWidget(btn_save)

        btn_cancel = QPushButton('Отмена')
        btn_cancel.setStyleSheet(db.STYLES['btn_neutral'])
        btn_cancel.clicked.connect(self.reject)
        btn_bar.addWidget(btn_cancel)

        layout.addLayout(btn_bar)

    def load_data(self):
        order = db.get_item_by_id('orders', self.order_id)
        if not order:
            return

        self.input_article.setText(order.get('article', ''))

        # Статус
        status = order.get('status', '')
        idx = self.combo_status.findText(status)
        if idx >= 0:
            self.combo_status.setCurrentIndex(idx)

        # Пункт выдачи
        pp_id = order.get('pickup_point_id')
        for i in range(self.combo_pickup.count()):
            if self.combo_pickup.itemData(i) == pp_id:
                self.combo_pickup.setCurrentIndex(i)
                break

        # Даты
        self.set_date(self.date_order, order.get('order_date'))
        self.set_date(self.date_delivery, order.get('delivery_date'))

    def set_date(self, date_edit, date_value):
        if date_value:
            if hasattr(date_value, 'year'):
                date_edit.setDate(QDate(date_value.year, date_value.month, date_value.day))
            else:
                parts = str(date_value)[:10].split('-')
                if len(parts) == 3:
                    date_edit.setDate(QDate(int(parts[0]), int(parts[1]), int(parts[2])))

    def save(self):
        if not self.input_article.text().strip():
            QMessageBox.warning(self, 'Ошибка', 'Артикул не может быть пустым')
            return

        if self.date_delivery.date() < self.date_order.date():
            QMessageBox.warning(self, 'Ошибка', 'Дата выдачи не может быть раньше даты заказа')
            return

        data = {
            'article': self.input_article.text().strip(),
            'status': self.combo_status.currentText(),
            'pickup_point_id': self.combo_pickup.currentData(),
            'order_date': self.date_order.date().toString('yyyy-MM-dd'),
            'delivery_date': self.date_delivery.date().toString('yyyy-MM-dd'),
            'client_name': '',
            'pickup_code': ''
        }

        try:
            if self.is_edit:
                db.update_item('orders', self.order_id, data)
            else:
                db.add_item('orders', data)
            QMessageBox.information(self, 'Успех', 'Заказ сохранён')
            self.accept()
            self.parent().load_orders()
        except Exception as e:
            QMessageBox.critical(self, 'Ошибка', f'Не удалось сохранить: {e}')

