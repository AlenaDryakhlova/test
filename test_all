import pymysql
import pymysql.cursors

DB_CONFIG = {
    'host': 'localhost',
    'user': 'root',
    'password': '12345',
    'database': 'shoes_store',
    'charset': 'utf8mb4',
    'cursorclass': pymysql.cursors.DictCursor
}

STYLES = {
    'btn_accent':    'QPushButton { background-color: #4CAF50; color: white; padding: 6px 12px; border-radius: 4px; } QPushButton:hover { background-color: #45a049; }',
    'btn_secondary': 'QPushButton { background-color: #2196F3; color: white; padding: 6px 12px; border-radius: 4px; } QPushButton:hover { background-color: #0b7dda; }',
    'btn_neutral':   'QPushButton { background-color: #ddd; padding: 6px 12px; border-radius: 4px; } QPushButton:hover { background-color: #ccc; }',
    'btn_danger':    'QPushButton { background-color: #f44336; color: white; padding: 6px 12px; border-radius: 4px; } QPushButton:hover { background-color: #da190b; }',
}

def get_connection():
    return pymysql.connect(**DB_CONFIG)

def get_user(login, password):
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            cursor.execute("""
                SELECT u.id, u.full_name, r.name AS role
                FROM users u JOIN roles r ON u.role_id = r.id
                WHERE u.login = %s AND u.password = %s
            """, (login, password))
            return cursor.fetchone()
    finally:
        conn.close()

def get_items(table, order=''):
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            cursor.execute(f"SELECT * FROM {table} {order}".strip())
            return cursor.fetchall()
    finally:
        conn.close()

def get_item_by_id(table, item_id):
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            cursor.execute(f"SELECT * FROM {table} WHERE id = %s", (item_id,))
            return cursor.fetchone()
    finally:
        conn.close()

def add_item(table, data):
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            cols = ', '.join(data.keys())
            vals = ', '.join(['%s'] * len(data))
            cursor.execute(f"INSERT INTO {table} ({cols}) VALUES ({vals})", list(data.values()))
        conn.commit()
    finally:
        conn.close()

def update_item(table, item_id, data):
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            set_clause = ', '.join([f"{k}=%s" for k in data.keys()])
            cursor.execute(f"UPDATE {table} SET {set_clause} WHERE id=%s", list(data.values()) + [item_id])
        conn.commit()
    finally:
        conn.close()

def delete_item(table, item_id):
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            cursor.execute(f"DELETE FROM {table} WHERE id = %s", (item_id,))
        conn.commit()
    finally:
        conn.close()

def get_products(search='', supplier_id=None, sort_qty=None):
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            params, where_clauses = [], []

            if search:
                like = f'%{search}%'
                where_clauses.append(
                    '(p.name LIKE %s OR p.description LIKE %s OR c.name LIKE %s '
                    'OR m.name LIKE %s OR s.name LIKE %s OR p.article LIKE %s OR p.unit LIKE %s)'
                )
                params.extend([like] * 7)

            if supplier_id:
                where_clauses.append('p.supplier_id = %s')
                params.append(supplier_id)

            where = 'WHERE ' + ' AND '.join(where_clauses) if where_clauses else ''
            order = {'asc': 'ORDER BY p.quantity ASC', 'desc': 'ORDER BY p.quantity DESC'}.get(sort_qty, '')

            cursor.execute(f"""
                SELECT p.*, c.name AS category, m.name AS manufacturer, s.name AS supplier
                FROM products p
                JOIN categories c ON p.category_id = c.id
                JOIN manufacturers m ON p.manufacturer_id = m.id
                JOIN suppliers s ON p.supplier_id = s.id
                {where} {order}
            """, params)
            return cursor.fetchall()
    finally:
        conn.close()

def product_in_orders(article):
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            cursor.execute("SELECT COUNT(*) AS cnt FROM orders WHERE article LIKE %s", (f'%{article}%',))
            return cursor.fetchone()['cnt'] > 0
    finally:
        conn.close()

def get_orders():
    conn = get_connection()
    try:
        with conn.cursor() as cursor:
            cursor.execute("""
                SELECT o.*, pp.address AS pickup_address
                FROM orders o
                LEFT JOIN pickup_points pp ON o.pickup_point_id = pp.id
                ORDER BY o.id
            """)
            return cursor.fetchall()
    finally:
        conn.close()

def get_pickup_points():
    return get_items('pickup_points', 'ORDER BY id')

def get_categories():
    return get_items('categories', 'ORDER BY name')

def get_manufacturers():
    return get_items('manufacturers', 'ORDER BY name')

def get_suppliers():
    return get_items('suppliers', 'ORDER BY name')

# login_window.py
import os

from PyQt6.QtCore import Qt
from PyQt6.QtGui import QPixmap, QFont
from PyQt6.QtWidgets import (
    QMainWindow, QWidget, QVBoxLayout, QLabel, QLineEdit,
    QPushButton, QMessageBox
)

import db


class LoginWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle('Авторизация — ООО «Обувь»')
        self.setMinimumSize(400, 450)
        self.products_window = None
        self.setup_ui()

    def setup_ui(self):
        central = QWidget()
        central.setStyleSheet('background-color: #FFFFFF;')
        self.setCentralWidget(central)

        layout = QVBoxLayout(central)
        layout.setContentsMargins(40, 30, 40, 30)
        layout.setSpacing(12)

        # Логотип
        logo_label = QLabel()
        logo_path = os.path.join(os.path.dirname(__file__), 'icon.png')
        if os.path.exists(logo_path):
            pixmap = QPixmap(logo_path)
            logo_label.setPixmap(pixmap.scaled(200, 80, Qt.AspectRatioMode.KeepAspectRatio))
        logo_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(logo_label)

        # Заголовок
        title = QLabel('Вход в систему')
        title.setFont(QFont('Times New Roman', 15, QFont.Weight.Bold))
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        layout.addSpacing(8)

        # Поля ввода
        self.input_login = QLineEdit()
        self.input_login.setPlaceholderText('Введите логин')
        self.input_login.setFont(QFont('Times New Roman', 11))
        self.input_login.setFixedHeight(32)
        layout.addWidget(self.input_login)

        self.input_password = QLineEdit()
        self.input_password.setEchoMode(QLineEdit.EchoMode.Password)
        self.input_password.setPlaceholderText('Введите пароль')
        self.input_password.setFont(QFont('Times New Roman', 11))
        self.input_password.setFixedHeight(32)
        self.input_password.returnPressed.connect(self.on_login)
        layout.addWidget(self.input_password)

        layout.addSpacing(10)

        # Кнопки
        btn_login = QPushButton('Войти')
        btn_login.setStyleSheet(db.STYLES['btn_accent'])
        btn_login.clicked.connect(self.on_login)
        layout.addWidget(btn_login)

        btn_guest = QPushButton('Войти как гость')
        btn_guest.setStyleSheet(db.STYLES['btn_secondary'])
        btn_guest.clicked.connect(self.on_guest)
        layout.addWidget(btn_guest)

        layout.addStretch()

    def on_login(self):
        login = self.input_login.text().strip()
        password = self.input_password.text().strip()

        if not login or not password:
            QMessageBox.warning(self, 'Ошибка', 'Введите логин и пароль')
            return

        try:
            user = db.get_user(login, password)
        except Exception as e:
            QMessageBox.critical(self, 'Ошибка', f'Ошибка подключения: {e}')
            return

        if not user:
            QMessageBox.warning(self, 'Ошибка', 'Неверный логин или пароль')
            self.input_password.clear()
            return

        self.open_products(user)

    def on_guest(self):
        self.open_products(None)

    def open_products(self, user):
        from products_window import ProductsWindow
        self.products_window = ProductsWindow(user, self)
        self.products_window.show()
        self.hide()

