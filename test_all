)

import db


class OrderItemWidget(QFrame):
    def __init__(self, order, user, parent_window):
        super().__init__()
        self.order = order
        self.user = user
        self.parent = parent_window
        self.setStyleSheet(
            'QFrame { background-color: #FFFFFF; border: 1px solid #ccc; border-radius: 4px; margin: 2px; }')
        self.setMinimumHeight(90)
        self.setup_ui()

    def setup_ui(self):
        layout = QHBoxLayout(self)
        layout.setContentsMargins(12, 8, 8, 8)

        # Информация о заказе
        info_label = QLabel()
        info_label.setFont(QFont('Times New Roman', 11))
        info_label.setWordWrap(True)
        info_label.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)
        info_label.setText(self.build_info())
        layout.addWidget(info_label, 1)

        # Дата доставки
        delivery = self.order.get('delivery_date', '')
        delivery_str = str(delivery)[:10] if delivery else '—'
        lbl_delivery = QLabel(f'Дата доставки:\n{delivery_str}')
        lbl_delivery.setFont(QFont('Times New Roman', 11))
        lbl_delivery.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lbl_delivery.setFixedWidth(130)
        lbl_delivery.setStyleSheet('border: 1px solid #aaa; background: #f9f9f9; border-radius: 4px; padding: 4px;')
        layout.addWidget(lbl_delivery)

        # Кнопки (только для админа)
        role = self.user.get('role', '') if self.user else ''
        if role == 'Администратор':
            btn_edit = QPushButton('Изменить')
            btn_edit.setStyleSheet(db.STYLES['btn_secondary'])
            btn_edit.clicked.connect(lambda: self.parent.open_order_form(self.order['id']))
            layout.addWidget(btn_edit)

            btn_del = QPushButton('Удалить')
            btn_del.setStyleSheet(db.STYLES['btn_danger'])
            btn_del.clicked.connect(self.on_delete)
            layout.addWidget(btn_del)

    def build_info(self):
        o = self.order
        article = o.get('article', '')
        status = o.get('status', '')
        address = o.get('pickup_address', '') or '—'
        order_date = str(o.get('order_date', ''))[:10]

        return (f'<b>Артикул заказа: {article}</b><br>'
                f'Статус: {status}<br>'
                f'Пункт выдачи: {address}<br>'
                f'Дата заказа: {order_date}')

    def on_delete(self):
        reply = QMessageBox.question(self, 'Подтверждение', f'Удалить заказ №{self.order["id"]}?',
                                     QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if reply != QMessageBox.StandardButton.Yes:
            return

        try:
            db.delete_item('orders', self.order['id'])
            QMessageBox.information(self, 'Успех', 'Заказ удалён')
            self.parent.load_orders()
        except Exception as e:
            QMessageBox.critical(self, 'Ошибка', f'Не удалось удалить: {e}')


class OrdersWindow(QMainWindow):
    def __init__(self, user, products_window):
        super().__init__()
        self.user = user
        self.products_window = products_window
        self.setWindowTitle('Заказы — ООО «Обувь»')
        self.setMinimumSize(800, 500)
        self.setup_ui()
        self.load_orders()

    def setup_ui(self):
        central = QWidget()
        central.setStyleSheet('background-color: #FFFFFF;')
        self.setCentralWidget(central)

        root = QVBoxLayout(central)
        root.setContentsMargins(10, 10, 10, 10)

        # Верхняя панель
        top_bar = QHBoxLayout()

        lbl_title = QLabel('Список заказов')
        lbl_title.setFont(QFont('Times New Roman', 14, QFont.Weight.Bold))
        top_bar.addWidget(lbl_title)
        top_bar.addStretch()

        full_name = self.user.get('full_name', '') if self.user else ''
        lbl_fio = QLabel(full_name)
        lbl_fio.setFont(QFont('Times New Roman', 11, QFont.Weight.Bold))
        top_bar.addWidget(lbl_fio)

        btn_back = QPushButton('Назад')
        btn_back.setStyleSheet(db.STYLES['btn_neutral'])
        btn_back.clicked.connect(self.close)
        top_bar.addWidget(btn_back)

        root.addLayout(top_bar)

        # Кнопка добавления (только админ)
        role = self.user.get('role', '') if self.user else ''
        if role == 'Администратор':
            btn_add = QPushButton('+ Добавить заказ')
            btn_add.setStyleSheet(db.STYLES['btn_accent'])
            btn_add.clicked.connect(lambda: self.open_order_form(None))
            root.addWidget(btn_add, 0, Qt.AlignmentFlag.AlignLeft)

        # Список заказов
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setStyleSheet('QScrollArea { border: none; }')

        self.list_widget = QWidget()
        self.list_layout = QVBoxLayout(self.list_widget)
        self.list_layout.setContentsMargins(0, 0, 0, 0)
        self.list_layout.setSpacing(4)
        self.list_layout.addStretch()

        scroll.setWidget(self.list_widget)
        root.addWidget(scroll, 1)

    def load_orders(self):
        try:
            orders = db.get_orders()
        except Exception as e:
            QMessageBox.critical(self, 'Ошибка', f'Не удалось загрузить заказы: {e}')
            return

        # Очистка списка
        while self.list_layout.count() > 1:
            item = self.list_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        if not orders:
            lbl = QLabel('Заказы не найдены')
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.list_layout.insertWidget(0, lbl)
        else:
            for i, order in enumerate(orders):
                self.list_layout.insertWidget(i, OrderItemWidget(order, self.user, self))

    def open_order_form(self, order_id):
        from order_form import OrderFormWindow
        form = OrderFormWindow(order_id, self)
        form.show()

import os
import shutil
from PyQt6.QtWidgets import (
