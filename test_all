            btn_del.clicked.connect(self._on_delete)
            layout.addWidget(btn_del)

    def _on_delete(self):
        name = self.product.get('name', '')
        reply = QMessageBox.question(self, 'Подтверждение', f'Удалить товар "{name}"?',
                                     QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if reply != QMessageBox.StandardButton.Yes:
            return
        if db.product_in_orders(self.product.get('article', '')):
            QMessageBox.warning(self, 'Ошибка', f'Товар "{name}" есть в заказах, удаление невозможно')
            return
        try:
            db.delete_item('products', self.product['id'])
            QMessageBox.information(self, 'Успех', 'Товар удалён')
            self.parent_window.load_products()
        except Exception as e:
            QMessageBox.critical(self, 'Ошибка', f'Не удалось удалить: {e}')


class ProductsWindow(QMainWindow):
    def __init__(self, user, login_window):
        super().__init__()
        self.user = user
        self.login_window = login_window
        self.edit_window = None
        self.search_timer = QTimer()
        self.search_timer.setSingleShot(True)
        self.search_timer.timeout.connect(self.load_products)

        role = self.user.get('role', 'Гость') if self.user else 'Гость'
        self.setWindowTitle(f'Список товаров — ООО «Обувь» [{role}]')
        self.setMinimumSize(900, 600)
        self._setup_ui()
        self.load_products()

    def _setup_ui(self):
        central = QWidget()
        central.setStyleSheet('background-color: #FFFFFF;')
        self.setCentralWidget(central)

        root = QVBoxLayout(central)
        root.setContentsMargins(10, 10, 10, 10)

        role = self.user.get('role', '') if self.user else ''

        # Верхняя панель
        top_bar = QHBoxLayout()
        logo_label = QLabel()
        logo_path = os.path.join(os.path.dirname(__file__), 'logo.png')
        if os.path.exists(logo_path):
            logo_label.setPixmap(QPixmap(logo_path).scaled(100, 40, Qt.AspectRatioMode.KeepAspectRatio))
        else:
            logo_label.setText('ООО «Обувь»')
            logo_label.setFont(QFont('Times New Roman', 12, QFont.Weight.Bold))
        top_bar.addWidget(logo_label)
        top_bar.addStretch()

        if role in ('Менеджер', 'Администратор'):
            btn_orders = QPushButton('Заказы')
            btn_orders.setStyleSheet(db.STYLES['btn_secondary'])
            btn_orders.clicked.connect(self._open_orders)
            top_bar.addWidget(btn_orders)

        lbl_fio = QLabel(self.user.get('full_name', '') if self.user else 'Гость')
        lbl_fio.setFont(QFont('Times New Roman', 11, QFont.Weight.Bold))
        top_bar.addWidget(lbl_fio)

        btn_logout = QPushButton('Выйти')
        btn_logout.setStyleSheet(db.STYLES['btn_neutral'])
        btn_logout.clicked.connect(self._on_logout)
        top_bar.addWidget(btn_logout)
        root.addLayout(top_bar)

        # Фильтры
        if role in ('Менеджер', 'Администратор'):
            filter_bar = QHBoxLayout()

            self.input_search = QLineEdit()
            self.input_search.setPlaceholderText('Поиск...')
            self.input_search.textChanged.connect(lambda: self.search_timer.start(300))
            filter_bar.addWidget(self.input_search, 2)

            self.combo_supplier = QComboBox()
            self.combo_supplier.addItem('Все поставщики', None)
            for sup in db.get_suppliers():
                self.combo_supplier.addItem(sup['name'], sup['id'])
            self.combo_supplier.currentIndexChanged.connect(lambda: self.search_timer.start(300))
            filter_bar.addWidget(self.combo_supplier, 1)

            self.combo_sort = QComboBox()
            self.combo_sort.addItem('Без сортировки', None)
            self.combo_sort.addItem('Кол-во: по возрастанию', 'asc')
            self.combo_sort.addItem('Кол-во: по убыванию', 'desc')
            self.combo_sort.currentIndexChanged.connect(lambda: self.search_timer.start(300))
            filter_bar.addWidget(self.combo_sort, 1)
            root.addLayout(filter_bar)

        if role == 'Администратор':
            btn_add = QPushButton('+ Добавить товар')
            btn_add.setStyleSheet(db.STYLES['btn_accent'])
            btn_add.clicked.connect(lambda: self.open_product_form(None))
            root.addWidget(btn_add, 0, Qt.AlignmentFlag.AlignLeft)

        # Список товаров
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setStyleSheet('QScrollArea { border: none; }')
        self.list_widget = QWidget()
        self.list_layout = QVBoxLayout(self.list_widget)
        self.list_layout.setContentsMargins(0, 0, 0, 0)
        self.list_layout.setSpacing(4)
        self.list_layout.addStretch()
        scroll.setWidget(self.list_widget)
        root.addWidget(scroll, 1)

    def load_products(self):
        role = self.user.get('role', '') if self.user else ''
        search, supplier_id, sort_qty = '', None, None
        if role in ('Менеджер', 'Администратор'):
            search = self.input_search.text().strip()
            supplier_id = self.combo_supplier.currentData()
            sort_qty = self.combo_sort.currentData()

        try:
            products = db.get_products(search, supplier_id, sort_qty)
        except Exception as e:
            QMessageBox.critical(self, 'Ошибка', f'Не удалось загрузить товары: {e}')
            return

        while self.list_layout.count() > 1:
            item = self.list_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        if not products:
            lbl = QLabel('Товары не найдены')
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.list_layout.insertWidget(0, lbl)
        else:
            for i, product in enumerate(products):
                self.list_layout.insertWidget(i, ProductItemWidget(product, self.user, self))

    def open_product_form(self, product_id):
        if self.edit_window and self.edit_window.isVisible():
            self.edit_window.activateWindow()
            return
        from product_form import ProductFormWindow
        self.edit_window = ProductFormWindow(product_id, self)
        self.edit_window.show()

    def _open_orders(self):
        from orders_window import OrdersWindow
        self.orders_window = OrdersWindow(self.user, self)
        self.orders_window.show()

    def _on_logout(self):
        self.login_window.input_login.clear()
        self.login_window.input_password.clear()
        self.login_window.show()
        self.close()

